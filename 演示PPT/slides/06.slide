<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#0B1220', fontFamily: '微软雅黑', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', top: 30, left: 64, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ paddingLeft: 12, paddingRight: 12, paddingTop: 5, paddingBottom: 5, borderRadius: 12, background: '#1E3A5F' }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#7EB3F0' }}>STEP 04</Text>
        </Box>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#F1F5F9' }}>时间轴编辑 · 一次真实对话</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 30, right: 64, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <FAIcon name='comments' style={{ fill: '#22D3EE', width: 18, height: 18 }} />
        <Text style={{ fontSize: 14, color: '#67D8EA' }}>对话即操作</Text>
    </Box>

    <Box style={{ position: 'absolute', top: 100, left: 64, width: 1152, height: 268, borderRadius: 10, overflow: 'hidden', border: { left: { width: 1, color: '#24344F' }, right: { width: 1, color: '#24344F' }, top: { width: 1, color: '#24344F' }, bottom: { width: 1, color: '#24344F' } } }}>
        <Box style={{ height: 32, background: '#16223A', paddingLeft: 14, flexDirection: 'row', alignItems: 'center', gap: 8, border: { bottom: { width: 1, color: '#24344F' } } }}>
            <Box style={{ width: 9, height: 9, borderRadius: 5, background: '#F09595' }} />
            <Box style={{ width: 9, height: 9, borderRadius: 5, background: '#FAC775' }} />
            <Box style={{ width: 9, height: 9, borderRadius: 5, background: '#97C459' }} />
            <Text style={{ fontSize: 13, color: '#7EA6D8', marginLeft: 10 }}>系统输出 · 时间轴预览与对话式编辑（实际界面）</Text>
        </Box>
        <Image src='assets/ui_edit2.png' style={{ width: 1152, height: 236, objectFit: 'cover', objectPosition: 'top' }} />
    </Box>

    <Box style={{ position: 'absolute', top: 388, left: 64, width: 560, flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 14, color: '#5B7BA6', letterSpacing: 2 }}>我实际输入的那句话</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 10, padding: 15, background: '#121C2E', borderRadius: 9, border: { left: { width: 3, color: '#3B82F6' } } }}>
            <FAIcon name='user' style={{ fill: '#64748B', width: 18, height: 18 }} />
            <Text style={{ fontSize: 15, color: '#E2ECF8', lineHeight: 1.6 }}>把第三镜改成近景</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 10, padding: 15, background: '#121C2E', borderRadius: 9, border: { left: { width: 3, color: '#22D3EE' } } }}>
            <FAIcon name='robot' style={{ fill: '#22D3EE', width: 18, height: 18 }} />
            <Text style={{ fontSize: 15, color: '#67D8EA', lineHeight: 1.6 }}>已解析意图，第 3 镜景别已改写为「近景」，其余参数保持不变</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', top: 388, left: 656, width: 560, flexDirection: 'column', gap: 10 }}>
        <Text style={{ fontSize: 14, color: '#5B7BA6', letterSpacing: 2 }}>系统内部实际改了什么</Text>
        <Box style={{ flexDirection: 'column', gap: 7, padding: 15, background: '#0E1A2C', borderRadius: 9, border: { left: { width: 1, color: '#24344F' }, right: { width: 1, color: '#24344F' }, top: { width: 1, color: '#24344F' }, bottom: { width: 1, color: '#24344F' } } }}>
            <Box style={{ flexDirection: 'row', gap: 10 }}>
                <Text style={{ fontSize: 13, color: '#5B7BA6', width: 84 }}>目标镜头</Text>
                <Text style={{ fontSize: 13, color: '#C4D4E8' }}>shot_3（柯岩揽胜）</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 10 }}>
                <Text style={{ fontSize: 13, color: '#5B7BA6', width: 84 }}>字段</Text>
                <Text style={{ fontSize: 13, color: '#C4D4E8' }}>shotType</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 10 }}>
                <Text style={{ fontSize: 13, color: '#5B7BA6', width: 84 }}>原值 → 新值</Text>
                <Text style={{ fontSize: 13, color: '#67D8EA' }}>全景 → 近景</Text>
            </Box>
            <Box style={{ flexDirection: 'row', gap: 10 }}>
                <Text style={{ fontSize: 13, color: '#5B7BA6', width: 84 }}>是否重生成</Text>
                <Text style={{ fontSize: 13, color: '#C4D4E8' }}>否，仅记录参数变更</Text>
            </Box>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', top: 588, left: 64, width: 1152, flexDirection: 'row', alignItems: 'center', gap: 14, paddingTop: 12, paddingBottom: 12, paddingLeft: 18, paddingRight: 18, background: '#0E1A2C', borderRadius: 9, border: { left: { width: 1, color: '#24344F' }, right: { width: 1, color: '#24344F' }, top: { width: 1, color: '#24344F' }, bottom: { width: 1, color: '#24344F' } } }}>
        <FAIcon name='wand-magic-sparkles' style={{ fill: '#F59E0B', width: 24, height: 24 }} />
        <Text style={{ fontSize: 15, color: '#C4D4E8' }}>不用找参数面板、不用改 JSON——<b>说人话，系统自动定位字段并改写</b>。这是「创编一体」的核心交互。</Text>
    </Box>

    <Box style={{ position: 'absolute', bottom: 20, left: 64, right: 64, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Box style={{ width: 1080, height: 4, background: '#1B2941', borderRadius: 2 }}>
            <Box style={{ width: 648, height: 4, background: '#3B82F6', borderRadius: 2 }} />
        </Box>
        <Text style={{ fontSize: 14, color: '#3B82F6', fontWeight: 'bold' }}>06 / 10</Text>
    </Box>
</Slide>
