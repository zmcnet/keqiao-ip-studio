<Slide style={{ width: 1280, height: 720, position: 'relative', background: '#0B1220', fontFamily: '微软雅黑', overflow: 'hidden' }}>
    <Box style={{ position: 'absolute', top: 30, left: 64, flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Box style={{ paddingLeft: 12, paddingRight: 12, paddingTop: 5, paddingBottom: 5, borderRadius: 12, background: '#1E3A5F' }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#7EB3F0' }}>运行链路</Text>
        </Box>
        <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#F1F5F9' }}>一次完整运行 · 五步走完</Text>
    </Box>
    <Box style={{ position: 'absolute', top: 30, right: 64, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#10B981' }} />
        <Text style={{ fontSize: 14, color: '#7EA6D8' }}>实测总耗时 ≈ 2 分 30 秒</Text>
    </Box>

    <Box style={{ position: 'absolute', top: 104, left: 64, width: 1152, flexDirection: 'column', gap: 11 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, paddingTop: 13, paddingBottom: 13, paddingLeft: 18, paddingRight: 18, background: '#121C2E', borderRadius: 9, border: { left: { width: 3, color: '#3B82F6' } } }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#3B82F6', width: 44 }}>01</Text>
            <Box style={{ width: 118 }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E2ECF8' }}>智能策划</Text></Box>
            <Box style={{ width: 236 }}>
                <Text style={{ fontSize: 12, color: '#5B7BA6' }}>输入</Text>
                <Text style={{ fontSize: 13, color: '#8FA6C2' }}>一句主题描述（支持语音）</Text>
            </Box>
            <FAIcon name='arrow-right' style={{ fill: '#24344F', width: 16, height: 16 }} />
            <Box style={{ width: 320 }}>
                <Text style={{ fontSize: 12, color: '#5B7BA6' }}>输出</Text>
                <Text style={{ fontSize: 13, color: '#8FA6C2' }}>世界观 + 6 角色 + 6 镜脚本</Text>
            </Box>
            <FAIcon name='arrow-right' style={{ fill: '#24344F', width: 16, height: 16 }} />
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#22D3EE' }}>≈ 22s</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, paddingTop: 13, paddingBottom: 13, paddingLeft: 18, paddingRight: 18, background: '#121C2E', borderRadius: 9, border: { left: { width: 3, color: '#3B82F6' } } }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#3B82F6', width: 44 }}>02</Text>
            <Box style={{ width: 118 }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E2ECF8' }}>角色资产</Text></Box>
            <Box style={{ width: 236 }}>
                <Text style={{ fontSize: 12, color: '#5B7BA6' }}>输入</Text>
                <Text style={{ fontSize: 13, color: '#8FA6C2' }}>策划产出的角色设定</Text>
            </Box>
            <FAIcon name='arrow-right' style={{ fill: '#24344F', width: 16, height: 16 }} />
            <Box style={{ width: 320 }}>
                <Text style={{ fontSize: 12, color: '#5B7BA6' }}>输出</Text>
                <Text style={{ fontSize: 13, color: '#8FA6C2' }}>6 张标准立绘（种子图）</Text>
            </Box>
            <FAIcon name='arrow-right' style={{ fill: '#24344F', width: 16, height: 16 }} />
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#22D3EE' }}>≈ 38s</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, paddingTop: 13, paddingBottom: 13, paddingLeft: 18, paddingRight: 18, background: '#121C2E', borderRadius: 9, border: { left: { width: 3, color: '#22D3EE' } } }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#22D3EE', width: 44 }}>03</Text>
            <Box style={{ width: 118 }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E2ECF8' }}>分镜生成</Text></Box>
            <Box style={{ width: 236 }}>
                <Text style={{ fontSize: 12, color: '#5B7BA6' }}>输入</Text>
                <Text style={{ fontSize: 13, color: '#8FA6C2' }}>分镜脚本 + 角色种子图</Text>
            </Box>
            <FAIcon name='arrow-right' style={{ fill: '#24344F', width: 16, height: 16 }} />
            <Box style={{ width: 320 }}>
                <Text style={{ fontSize: 12, color: '#5B7BA6' }}>输出</Text>
                <Text style={{ fontSize: 13, color: '#8FA6C2' }}>6 张 1024×1536 分镜成图</Text>
            </Box>
            <FAIcon name='arrow-right' style={{ fill: '#24344F', width: 16, height: 16 }} />
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#22D3EE' }}>≈ 46s</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, paddingTop: 13, paddingBottom: 13, paddingLeft: 18, paddingRight: 18, background: '#121C2E', borderRadius: 9, border: { left: { width: 3, color: '#3B82F6' } } }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#3B82F6', width: 44 }}>04</Text>
            <Box style={{ width: 118 }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#E2ECF8' }}>时间轴预览</Text></Box>
            <Box style={{ width: 236 }}>
                <Text style={{ fontSize: 12, color: '#5B7BA6' }}>输入</Text>
                <Text style={{ fontSize: 13, color: '#8FA6C2' }}>自然语言修改指令</Text>
            </Box>
            <FAIcon name='arrow-right' style={{ fill: '#24344F', width: 16, height: 16 }} />
            <Box style={{ width: 320 }}>
                <Text style={{ fontSize: 12, color: '#5B7BA6' }}>输出</Text>
                <Text style={{ fontSize: 13, color: '#8FA6C2' }}>改写后的分镜参数 + 配音</Text>
            </Box>
            <FAIcon name='arrow-right' style={{ fill: '#24344F', width: 16, height: 16 }} />
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#22D3EE' }}>≈ 28s</Text>
        </Box>

        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, paddingTop: 13, paddingBottom: 13, paddingLeft: 18, paddingRight: 18, background: '#18243A', borderRadius: 9, border: { left: { width: 3, color: '#F59E0B' } } }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#F59E0B', width: 44 }}>05</Text>
            <Box style={{ width: 118 }}><Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>成片导出</Text></Box>
            <Box style={{ width: 236 }}>
                <Text style={{ fontSize: 12, color: '#A67C2E' }}>输入</Text>
                <Text style={{ fontSize: 13, color: '#B9CCE4' }}>全部项目数据</Text>
            </Box>
            <FAIcon name='arrow-right' style={{ fill: '#3D4F6B', width: 16, height: 16 }} />
            <Box style={{ width: 320 }}>
                <Text style={{ fontSize: 12, color: '#A67C2E' }}>输出</Text>
                <Text style={{ fontSize: 13, color: '#B9CCE4' }}>文档 / 脚本 / 项目 / 图 / 海报</Text>
            </Box>
            <FAIcon name='arrow-right' style={{ fill: '#3D4F6B', width: 16, height: 16 }} />
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#F0B95A' }}>≈ 6s</Text>
        </Box>
    </Box>

    <Box style={{ position: 'absolute', top: 592, left: 64, width: 1152, flexDirection: 'row', alignItems: 'center', gap: 14, paddingTop: 12, paddingBottom: 12, paddingLeft: 18, paddingRight: 18, background: '#0E1A2C', borderRadius: 9, border: { left: { width: 1, color: '#24344F' }, right: { width: 1, color: '#24344F' }, top: { width: 1, color: '#24344F' }, bottom: { width: 1, color: '#24344F' } } }}>
        <FAIcon name='circuit-board' style={{ fill: '#22D3EE', width: 24, height: 24 }} />
        <Text style={{ fontSize: 15, color: '#C4D4E8' }}>数据流转：每步产出写入<b>同一个结构化项目模型</b>，下一步直接读取——不存在"策划归策划、生成归生成"的断层。</Text>
    </Box>

    <Box style={{ position: 'absolute', bottom: 22, left: 64, right: 64, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Box style={{ width: 1080, height: 4, background: '#1B2941', borderRadius: 2 }}>
            <Box style={{ width: 216, height: 4, background: '#3B82F6', borderRadius: 2 }} />
        </Box>
        <Text style={{ fontSize: 14, color: '#3B82F6', fontWeight: 'bold' }}>02 / 10</Text>
    </Box>
</Slide>
