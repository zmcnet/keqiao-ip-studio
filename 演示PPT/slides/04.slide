    <Box style={{ position: 'absolute', top: 566, left: 64, width: 1152, flexDirection: 'row', alignItems: 'center', gap: 14, paddingTop: 13, paddingBottom: 13, paddingLeft: 18, paddingRight: 18, background: '#0E1A2C', borderRadius: 9, border: { left: { width: 1, color: '#24344F' }, right: { width: 1, color: '#24344F' }, top: { width: 1, color: '#24344F' }, bottom: { width: 1, color: '#24344F' } } }}>
