    <Box style={{ position: 'absolute', top: 0, right: 0, width: 420, height: 104, background: 'linear-gradient(90deg, rgba(14,63,140,0) 0%, rgba(14,63,140,0.85) 100%)' }} />
    <Box style={{ position: 'absolute', top: 22, left: 46, flexDirection: 'column', gap: 6 }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>IP 家族 · 六位水乡小匠</Text>
        <Text style={{ fontSize: 15, color: '#BFD4F0' }}>每位绑定一处柯桥真实地标 / 非遗 · 差异化性格与视觉标识</Text>
